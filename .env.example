# Postgres connection string. If omitted, the server runs with an in-memory store (dev only — data is lost on restart).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uth
PORT=3000
# Set behind a TLS-terminating proxy (Render, Railway, Fly) so secure cookies/WSS work.
TRUST_PROXY=1
# Comma-separated origins allowed to open Socket.IO connections. Leave blank for same-origin only.
ALLOWED_ORIGINS=
